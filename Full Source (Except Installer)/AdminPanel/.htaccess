# Nutricula admin panel - server-level hardening.
# Place this file in the SAME folder as index.html / the admin_*.php files
# (the admin subdomain's docroot). Requires mod_headers, which is enabled by
# default on virtually every cPanel/Apache host - if a header below doesn't
# show up in the browser's network tab, ask the host to enable mod_headers.

<IfModule mod_headers.c>
  # Never let this page be framed by another site (clickjacking defense -
  # a transparent iframe over the login form tricking a click is the
  # classic attack this stops).
  Header always set X-Frame-Options "DENY"

  # Stops the browser from "helpfully" guessing a different content type
  # than the one the server declared (an old vector for turning an
  # uploaded/returned file into executable script in some browsers).
  Header always set X-Content-Type-Options "nosniff"

  # Never leak this panel's URL (which could reveal the subdomain name
  # itself) to a link clicked from inside it, and never leak it as a
  # referrer when this page's own JS calls out anywhere.
  Header always set Referrer-Policy "no-referrer"

  # Locks this page out of using the browser's own camera/mic/location/
  # payment APIs - it never needs any of them, so explicitly refusing them
  # removes an entire class of "found an XSS, now what can it do" questions.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # A strict allowlist: this page may only load scripts/styles/images/fonts
  # from itself. This is the single biggest lever against XSS - even if an
  # attacker somehow got a <script> tag onto this page, the browser simply
  # refuses to run anything not already shipped as one of this panel's own
  # files, and refuses to send data anywhere but back to this same origin.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Tells browsers that have ever seen this exact subdomain over HTTPS to
  # NEVER try it over plain HTTP again, even if someone types http:// or
  # clicks an old http:// link - closes the "strip the S and
  # man-in-the-middle the first request" downgrade attack. Only enable this
  # AFTER confirming the subdomain has a working, valid HTTPS certificate -
  # turning this on before that would make the site unreachable over HTTP
  # with no HTTPS to fall back to. Delete this line entirely until then.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Removes the "PHP/8.x" version banner some hosts add by default -
  # no reason to advertise exactly which PHP version/patch level is running.
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# Never list folder contents if an index file is ever missing.
Options -Indexes

# Defense in depth: nothing in this folder should ever be a dotfile, a
# editor backup, or a raw .sql/.bak dump - block them outright even though
# none should exist here in normal operation.
<FilesMatch "(^\.|~$|\.bak$|\.old$|\.sql$|\.log$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Hide PHP's own version banner at the engine level too, if mod_php (not
# PHP-FPM) is what's actually running this host's PHP.
<IfModule mod_php.c>
  php_flag expose_php off
</IfModule>
