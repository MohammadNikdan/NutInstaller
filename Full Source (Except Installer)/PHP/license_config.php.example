    'edd' => [
        'api_key' => 'YOUR_EDD_API_KEY',
        'api_token' => 'YOUR_EDD_API_TOKEN',
    ],

    /* Must match TransportKeyPrivate.h's TRANSPORT_KEY byte-for-byte
       (compiled into NutriculaLicenseService/Broker only - NOT into
       MachineId32/64.dll, which no longer contains any transport key at
       all as of this session's dead-code cleanup). Generate your own with
       e.g. `openssl rand -hex 32`, never reuse an example/sample value. */
    /* Path to a plain text file containing ONLY the 64-hex-character
       transport key - no extra whitespace, no quotes, nothing else in the
       file. Matches the same file-path pattern as
       server_signing_private_key_path above - the actual secret value
       never lives directly in this config file. */
    'transport_key_path' => '/home/nutricul/domains/nutriculaexpert.com/Private/Keys/TransportKey.txt',

    /* Existing server-side RSA private key used to sign the final license lease. */
    'server_signing_private_key_path' => '/home/nutricul/domains/nutriculaexpert.com/Private/Keys/ServerLicenseSigningKey_Private.pem',

    /* The current released EA version, e.g. '3.1'. Compared (via PHP's
       version_compare) against the version recorded in nutricula_build_
       manifests for whatever build_id a client reports as Artifact
       Evidence during license_check.php's verify stage. Any build older
       than this gets TIER_UPDATE_REQUIRED (-50) instead of a normal
       license outcome - see license_check.php's version-check comment for
       the exact reasoning. To publish a new mandatory-update version:
       raise this number, then sign and register the new build's manifest
       (see NutriculaSignTool) with a version >= this value. */
    'latest_version' => '3.1',

    'challenge_ttl_seconds' => 60,

    /* Informational only (not enforced by itself) - the nominal length of one
       MQL request cycle. MQL's own TTL is 55:00 minutes. Under the rotating
       refresh-token model, the client no longer requests at a fixed offset:
       after every successful lease, it picks a new random moment between
       10:01 and 50:00 after that lease's request_at (persistently derived
       from the new refresh token itself, so it survives Terminal/EA
       restarts and cannot be re-rolled) and requests again exactly then.
       This constant is only used for display-friendly estimates. */
    'license_cycle_seconds' => 3300, // 55 minutes

    /* THE enforced anti-abuse gate. A new request (challenge, or an existing-
       license signup) for the same license/device is rejected as too_early
       if fewer than this many seconds have passed since the last request
       (successful or rejected) for that license. Set well below the
       client's own minimum random offset (4:00) so a legitimate client
       following its own schedule never trips this - 3 minutes leaves the
       same ~61-second margin as before. There is deliberately NO upper
       bound. */
    'min_request_gap_seconds' => 179, // 2:59 (~3 minutes)

    /* How many hours a license is fully blocked (all requests rejected,
       tier -100) after two CONSECUTIVE stale-refresh-token presentations
       are detected for it - see nutricula_check_and_rotate_token() in
       license_common.php for the full state machine. */
    'clone_block_hours' => 24,

    /* Set true ONLY when the origin is locked to trusted Cloudflare proxy ranges. */
    'trust_cloudflare_connecting_ip' => false,

    /* Keep this list current with Cloudflare's published IP ranges if the option above is enabled. */
    'trusted_proxy_cidrs' => [
