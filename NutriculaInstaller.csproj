<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{4AA1C77B-6F18-4F2E-A7F9-9AA2B52F5B6E}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>NutriculaInstaller</RootNamespace>
    <AssemblyName>NutriculaExpertInstaller</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <Prefer32Bit>true</Prefer32Bit>
    <Nullable>disable</Nullable>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="Models.cs" />
    <Compile Include="InstallerService.cs" />
    <Compile Include="MachineIdService.cs" />
    <Compile Include="CryptoService.cs" />
    <Compile Include="TerminalDiscoveryService.cs" />
    <Compile Include="UiHelpers.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.ico" />

    <EmbeddedResource Include="Fonts\Outfit-Regular.ttf">
      <LogicalName>NutriculaInstaller.Fonts.Outfit-Regular.ttf</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\Nutricula.ex4">
      <LogicalName>NutriculaInstaller.Assets.Nutricula.ex4</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\Nutricula.ex5">
      <LogicalName>NutriculaInstaller.Assets.Nutricula.ex5</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\NutriculaLicenseCheck32.dll">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseCheck32.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\NutriculaLicenseCheck64.dll">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseCheck64.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\MachineId32.dll">
      <LogicalName>NutriculaInstaller.Assets.MachineId32.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\MachineId64.dll">
      <LogicalName>NutriculaInstaller.Assets.MachineId64.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\NutriculaLicenseService32.exe">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseService32.exe</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\NutriculaLicenseService64.exe">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseService64.exe</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\NutriculaLicenseBroker32.exe">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseBroker32.exe</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\NutriculaLicenseBroker64.exe">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseBroker64.exe</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\manifest.txt">
      <LogicalName>NutriculaInstaller.Assets.manifest.txt</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Assets\installerpic.jpg">
      <LogicalName>NutriculaInstaller.Assets.installerpic.jpg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateRequiredInstallerFiles" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\icon.ico')" Text="Required file missing: icon.ico (place it next to NutriculaInstaller.csproj)." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Fonts\Outfit-Regular.ttf')" Text="Required file missing: Fonts\Outfit-Regular.ttf" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\Nutricula.ex4')" Text="Required file missing: Assets\Nutricula.ex4" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\Nutricula.ex5')" Text="Required file missing: Assets\Nutricula.ex5" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\NutriculaLicenseCheck32.dll')" Text="Required file missing: Assets\NutriculaLicenseCheck32.dll" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\NutriculaLicenseCheck64.dll')" Text="Required file missing: Assets\NutriculaLicenseCheck64.dll" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\MachineId32.dll')" Text="Required file missing: Assets\MachineId32.dll" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\MachineId64.dll')" Text="Required file missing: Assets\MachineId64.dll" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\NutriculaLicenseService32.exe')" Text="Required file missing: Assets\NutriculaLicenseService32.exe" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\NutriculaLicenseService64.exe')" Text="Required file missing: Assets\NutriculaLicenseService64.exe" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\NutriculaLicenseBroker32.exe')" Text="Required file missing: Assets\NutriculaLicenseBroker32.exe" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\NutriculaLicenseBroker64.exe')" Text="Required file missing: Assets\NutriculaLicenseBroker64.exe" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\manifest.txt')" Text="Required file missing: Assets\manifest.txt" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\installerpic.jpg')" Text="Required file missing: Assets\installerpic.jpg" />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
