<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NutriculaInstaller.SelfContained.csproj

    The installer flavour that is bundled into the MAC and LINUX packages
    (workflows "2. Windows - 32bit (for Mac/Linux)" and
    "3. Windows - 64bit (for Mac/Linux)"). It is NEVER given to Windows users -
    they keep getting the build from ../NutriculaInstaller.csproj
    (workflow "1. Windows - 32bit"), which this file does not touch in any way.

    WHY A SECOND PROJECT FILE EXISTS: the MetaTrader 5 copy of Wine on a Mac
    has no .NET Framework / Mono registered inside it, so a normal
    ".NET Framework 4.8" exe dies at startup there (the exe loads, then
    mscoree.dll finds no runtime to host). This build brings its own .NET
    runtime (self-contained) with it, so it needs nothing registered in the
    Wine prefix at all.

    NOT bundled into a single file BY THIS PROJECT: PublishSingleFile is
    OFF here on purpose (see below). The workflows that build this project
    hand you a whole self-contained FOLDER, which you then run through
    .NET Reactor on your own machine - Reactor both protects the managed
    code AND does the single-file bundling itself (its own "Bundle"
    feature), producing the one final .exe. ConfuserEx cannot do this at
    all (it only understands a plain managed assembly, not a self-contained
    bundle), which is why this flavour uses .NET Reactor instead - see
    README-GITHUB-BUILD.md for the full signing flow.

    NO DUPLICATED CODE: this project compiles the very same .cs files and
    embeds the very same resources as ../NutriculaInstaller.csproj - they are
    just referenced from here by relative path. The few places where the two
    builds must differ are guarded in the source with
    "#if NET6_0_OR_GREATER" (true only for this project, never for the
    .NET Framework 4.8 build).

    KEEP IN SYNC: if a source file or embedded resource is added/removed in
    ../NutriculaInstaller.csproj, mirror it in the two lists below. The two
    SelfContained workflows compare both lists on every run and FAIL LOUDLY
    if they ever differ, so a mismatch can never slip through unnoticed.

    HOW IT IS BUILT (always through the workflows, never by hand):
      dotnet publish SelfContained/NutriculaInstaller.SelfContained.csproj
             -c Release -r win-x86 -p:PublishSingleFile=false   (or win-x64)
    The runtime identifier (-r) decides the architecture. PublishSingleFile
    is explicitly forced to false on the command line too (overriding
    nothing - see below, it already defaults to false here), spelled out so
    the command line alone says exactly what is built.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <RootNamespace>NutriculaInstaller</RootNamespace>
    <AssemblyName>NutriculaExpertInstaller</AssemblyName>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>

    <!-- The main project lists every item explicitly; so does this one.
         Nothing is picked up by folder scanning. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Properties\AssemblyInfo.cs (shared) already declares the assembly
         attributes; generating them again would be a duplicate-attribute error. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Self-contained (runtime included), published as a plain FOLDER, not
         a single file: PublishSingleFile is OFF - bundling into one exe is
         done later by .NET Reactor, not by dotnet publish (see the header
         comment above). Trimming is deliberately OFF too (this app reads
         embedded resources and uses reflection-style APIs; trimming could
         silently remove something it needs). -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Wine does not provide the ICU library that .NET uses for culture
         data on Windows; without this switch .NET can refuse to start there.
         Invariant mode needs no ICU at all. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Only English framework resources (the framework ships dozens of
         language packs that would only inflate the exe). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- SecurityProtocolType.Tls / Tls11 (used in InstallerService.cs) are
         flagged obsolete on modern .NET - warning only, behaviour unchanged. -->
    <NoWarn>$(NoWarn);SYSLIB0039</NoWarn>
  </PropertyGroup>

  <!-- Architecture follows the runtime identifier given with -r. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Same source files as ../NutriculaInstaller.csproj (that list also
       contains VendorPublicKeyEmbedded.cs, generated by the workflow). -->
  <ItemGroup>
    <Compile Include="..\Program.cs" />
    <Compile Include="..\MainForm.cs" />
    <Compile Include="..\Models.cs" />
    <Compile Include="..\AppConfig.cs" />
    <Compile Include="..\InstallerService.cs" />
    <Compile Include="..\AtomicFile.cs" />
    <Compile Include="..\UninstallService.cs" />
    <Compile Include="..\NutriculaSweeper.cs" />
    <Compile Include="..\MachineIdService.cs" />
    <Compile Include="..\CryptoService.cs" />
    <Compile Include="..\TerminalDiscoveryService.cs" />
    <Compile Include="..\UiHelpers.cs" />
    <Compile Include="..\VendorPublicKeyEmbedded.cs" />
    <Compile Include="..\SelfIntegrityCheck.cs" />
    <Compile Include="..\Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- Same embedded resources, same logical names, as ../NutriculaInstaller.csproj. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Fonts\Outfit-Regular.ttf">
      <LogicalName>NutriculaInstaller.Fonts.Outfit-Regular.ttf</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\Nutricula.ex4">
      <LogicalName>NutriculaInstaller.Assets.Nutricula.ex4</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\Nutricula.ex5">
      <LogicalName>NutriculaInstaller.Assets.Nutricula.ex5</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\NutriculaLicenseCheck32.dll">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseCheck32.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\NutriculaLicenseCheck64.dll">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseCheck64.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\MachineId32.dll">
      <LogicalName>NutriculaInstaller.Assets.MachineId32.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\MachineId64.dll">
      <LogicalName>NutriculaInstaller.Assets.MachineId64.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\NutriculaLicenseBroker32.exe">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseBroker32.exe</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\NutriculaLicenseBroker64.exe">
      <LogicalName>NutriculaInstaller.Assets.NutriculaLicenseBroker64.exe</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Assets\manifest.txt">
      <LogicalName>NutriculaInstaller.Assets.manifest.txt</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\Config\AppConfig.txt">
      <LogicalName>NutriculaInstaller.Config.AppConfig.txt</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="..\UIAssets\installerpic.jpg">
      <LogicalName>NutriculaInstaller.UIAssets.installerpic.jpg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
