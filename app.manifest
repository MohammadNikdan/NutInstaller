<?xml version="1.0" encoding="utf-8"?>
<!--
  app.manifest

  requestedExecutionLevel = asInvoker: this installer runs as a normal
  (non-elevated) process - NO UAC prompt, ever, for either install or
  uninstall (install and uninstall are the same .exe). This is correct
  because the whole product is a per-user install that needs no
  Administrator rights at all:
    - the Coordinator is the user-session Broker, installed under
      %LocalAppData% (not %ProgramFiles%) - see
      InstallerService.GetCoordinatorInstallDir,
    - the "Apps & Features" entry is registered in HKCU, not HKLM - see
      InstallerService.RegisterUninstaller,
    - there is no Windows Service to register (the Service host was removed
      in 2026; the Broker is the sole Coordinator),
    - the EA/DLL files are written into MetaTrader's own per-user data
      folders, the device key and license file into the user's %APPDATA%,
      and auto-start uses the HKCU Run key + a per-user Scheduled Task.
  Nothing here crosses into a machine-wide, elevation-requiring location.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="NutriculaExpertInstaller"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Standard Windows-version compatibility list so Windows does not
       apply legacy compatibility shims to this process - every modern
       Windows version this installer is expected to run on. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/> <!-- Windows Vista -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/> <!-- Windows 7 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/> <!-- Windows 8 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- Windows 8.1 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Windows 10 / 11 -->
    </application>
  </compatibility>
</assembly>
